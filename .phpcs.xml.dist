<?xml version="1.0"?>
<!-- Security sniffs only (escaping, nonces, sanitizing, SQL). Code style is
     not checked here: the project follows PSR-12, not WordPress style. -->
<ruleset name="CtrlField security">
    <!-- The whole plugin; the public Free repo simply has no pro/. -->
    <file>.</file>

    <exclude-pattern>/vendor/*</exclude-pattern>
    <exclude-pattern>/node_modules/*</exclude-pattern>
    <exclude-pattern>/dist/*</exclude-pattern>
    <exclude-pattern>/tests/*</exclude-pattern>
    <exclude-pattern>/pro/tests/*</exclude-pattern>
    <exclude-pattern>/pro/vendor/*</exclude-pattern>
    <exclude-pattern>/docs/*</exclude-pattern>

    <arg name="basepath" value="."/>
    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <rule ref="WordPress.Security">
        <!-- A thrown message is not output; the echo that shows one on an
             admin screen is what gets checked (OutputNotEscaped). -->
        <exclude name="WordPress.Security.EscapeOutput.ExceptionNotEscaped"/>
    </rule>
    <rule ref="WordPress.DB.PreparedSQL"/>
    <rule ref="WordPress.DB.PreparedSQLPlaceholders"/>
    <rule ref="WordPress.WP.GlobalVariablesOverride"/>
    <rule ref="Generic.PHP.BacktickOperator"/>
    <rule ref="Squiz.PHP.Eval"/>
    <rule ref="WordPress.PHP.DiscouragedPHPFunctions">
        <properties>
            <property name="exclude" type="array">
                <element value="obfuscation"/>
                <element value="serialize"/>
            </property>
        </properties>
    </rule>
    <rule ref="WordPress.PHP.RestrictedPHPFunctions"/>
</ruleset>
