{
    "name": "ctrlcheese/ctrlfield",
    "description": "Code-first custom fields, CPTs and taxonomies for WordPress, with license-unlocked Pro features.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.2",
        "composer/installers": "^2.3",
        "illuminate/support": "^11.0",
        "illuminate/view": "^11.0",
        "psr/container": "^2.0"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "digitalrevolution/php-codesniffer-baseline": "^1.1",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0|^12.0",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "wp-coding-standards/wpcs": "^3.1"
    },
    "autoload": {
        "psr-4": {
            "CtrlField\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CtrlField\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.2"
        },
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "digitalrevolution/php-codesniffer-baseline": true,
            "composer/installers": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "strauss": {
            "target_directory": "vendor-prefixed",
            "namespace_prefix": "CtrlField\\Vendor\\",
            "classmap_prefix": "CtrlField_Vendor_",
            "constant_prefix": "CTRLFIELD_VENDOR_",
            "update_call_sites": false,
            "delete_vendor_packages": true,
            "parallel": false,
            "exclude_from_copy": {
                "packages": [
                    "composer/installers",
                    "psr/container",
                    "psr/clock",
                    "psr/simple-cache"
                ]
            },
            "exclude_from_prefix": {
                "namespaces": [
                    "Psr\\"
                ]
            }
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:pro": "phpunit -c pro/phpunit.xml",
        "scope": [
            "bash -c 'test -f .tooling/strauss.phar || { mkdir -p .tooling && curl -sfL -o .tooling/strauss.phar https://github.com/BrianHenryIE/strauss/releases/download/0.31.1/strauss.phar; }'",
            "@php -d memory_limit=-1 .tooling/strauss.phar",
            "@php -r \"array_map('unlink', array_filter(['vendor/composer/autoload_aliases.php', 'vendor/composer/autoload_alias.php'], 'file_exists'));\""
        ],
        "post-install-cmd": [
            "@scope"
        ],
        "post-update-cmd": [
            "@scope"
        ]
    }
}
