{
    "name": "ctrlcheese/ctrlfield",
    "description": "Code-first custom fields, CPTs and taxonomies for WordPress, with license-unlocked Pro features.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.2",
        "psr/container": "^2.0",
        "illuminate/view": "^11.0",
        "illuminate/support": "^11.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0|^12.0",
        "szepeviktor/phpstan-wordpress": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "CtrlField\\": "src/"
        },
        "files": [
            "src/Integrations/Blade/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "CtrlField\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.2"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "phpunit",
        "test:pro": "phpunit -c pro/phpunit.xml"
    }
}
